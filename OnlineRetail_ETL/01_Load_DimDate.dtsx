      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C4A22B42-2EE7-4473-9F69-539DA4F23414}"
          SQLTask:SqlStatementSource="DELETE FROM dbo.DimDate;&#xA;&#xA;DECLARE @d DATE = '2009-01-01';&#xA;WHILE @d &lt;= '2012-12-31'&#xA;BEGIN&#xA;    INSERT INTO dbo.DimDate&#xA;    VALUES (&#xA;        CONVERT(INT, FORMAT(@d, 'yyyyMMdd')),&#xA;        @d,&#xA;        DAY(@d),&#xA;        DATENAME(WEEKDAY, @d),&#xA;        MONTH(@d),&#xA;        DATENAME(MONTH, @d),&#xA;        DATEPART(QUARTER, @d),&#xA;        'Q' + CAST(DATEPART(QUARTER, @d) AS VARCHAR(1)),&#xA;        YEAR(@d),&#xA;        CASE WHEN DATENAME(WEEKDAY, @d) IN ('Saturday','Sunday') THEN 1 ELSE 0 END&#xA;    );&#xA;    SET @d = DATEADD(DAY, 1, @d);&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
